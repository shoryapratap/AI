{
  "name": "emma-ai",
  "version": "1.0.0",
  "description": "Emma AI — Your Intelligent Windows Workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "Emma AI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.emma.ai",
    "productName": "Emma AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "frontend-react/dist/assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend-react/dist/**/*"
    ]
  }
}
